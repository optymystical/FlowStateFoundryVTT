<div class="fs-sheet">
  {{#if lockedNote}}<p class="fs-locked"><i class="fa-solid fa-lock"></i> {{lockedNote}}</p>{{/if}}
  <header class="fs-header">
    <img class="fs-portrait fs-small" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
    <div class="fs-header-main">
      <input class="fs-name" type="text" name="name" value="{{item.name}}" {{#unless nameEditable}}disabled{{/unless}}>
      <label>Quantity <input type="number" name="system.quantity" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}}></label>
      {{#if isGear}}<label>Ammunition for <select name="system.ammoType" {{#unless editable}}disabled{{/unless}}><option value="">— Not ammunition —</option>{{selectOptions ammoTypes selected=system.ammoType}}</select></label>{{/if}}
    </div>
  </header>
  {{#if isGear}}<div class="fs-field-row"><label>Body <small>(0 = not an object; ~1 per cubic foot)</small> <input type="number" name="system.body" value="{{system.body}}" min="0" {{#unless editable}}disabled{{/unless}}></label>
    <label>Material <select name="system.density" {{#unless editable}}disabled{{/unless}}>{{selectOptions densities selected=system.density}}</select></label>
    {{#if system.isObject}}<span class="hint">Durability {{system.durability.value}}/{{system.durability.max}} · Limit {{system.objectLimit}}</span>{{/if}}</div>{{/if}}
  <textarea name="system.description" rows="10" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
</div>
