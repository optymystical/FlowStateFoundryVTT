{{#if cat}}
<section class="fs-item-catalog">
  <div class="fs-cat-line">
    <i class="fa-solid fa-book"></i>
    {{#if cat.found}}
      <span>Catalog: <strong>{{cat.name}}</strong>{{#if cat.named}} <span class="fs-tag">Named</span>{{/if}}</span>
      {{#if cat.modified}}<span class="fs-sub" data-tooltip="Changed on this copy only (by the GM): {{cat.modified}}">· modified ({{cat.modified}})</span>{{/if}}
      {{#if cat.canReset}}<button type="button" class="fs-inline" data-action="resetToEntry" data-tooltip="Undo this copy's changes: back to the catalog entry"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}
    {{else}}
      <span class="fs-warn">{{#if cat.key}}Its catalog entry is gone: it works from its own copy of the data.{{else}}Not in the catalog.{{/if}}</span>
    {{/if}}
  </div>
  <div class="fs-carry">
    <label>Weight <input type="number" name="system.pounds" value="{{cat.pounds}}" min="0" step="any" placeholder="—" {{#unless editable}}disabled{{/unless}}> lb</label>
    <label>Volume <input type="number" name="system.volume" value="{{cat.volume}}" min="0" step="any" placeholder="—" {{#unless editable}}disabled{{/unless}}> ft³</label>
    <label>Price <input type="number" name="system.price" value="{{cat.price}}" min="0" step="any" placeholder="—" {{#unless editable}}disabled{{/unless}}></label>
  </div>
</section>
{{/if}}
