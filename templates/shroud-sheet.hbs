<div class="fs-sheet">
  <header class="fs-header">
    <img class="fs-portrait fs-small" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
    <div class="fs-header-main">
      <input class="fs-name" type="text" name="name" value="{{item.name}}" {{#unless nameEditable}}disabled{{/unless}}>
      {{#if p.valid}}<div class="fs-subtitle">Shroud · {{p.label}}</div>{{/if}}
    </div>
  </header>

  {{#if lockedNote}}<p class="fs-locked"><i class="fa-solid fa-lock"></i> {{lockedNote}}</p>{{/if}}
  <section class="fs-builder">
    <div class="fs-field"><label>Type</label>
      <select name="system.shroudType" {{#unless editable}}disabled{{/unless}}>{{selectOptions types selected=system.shroudType}}</select></div>
    <div class="fs-field"><label>Grade</label>
      <input type="number" name="system.grade" value="{{system.grade}}" min="1" {{#unless editable}}disabled{{/unless}}></div>
    <div class="fs-field fs-checks-row">
      <label><input type="checkbox" name="system.attuned" {{checked system.attuned}} {{#unless stateEditable}}disabled{{/unless}}> Attuned (melded)</label>
    </div>
  </section>

  {{#if p.valid}}
  <section class="fs-profile">
    <h3>Profile {{#unless owned}}<small>(previewed at the Grade cap)</small>{{/unless}}</h3>
    <div class="fs-kv">
      <span>Scaling</span><span>×{{p.mult}} (Build {{p.scaling}}, Grade {{p.grade}})</span>
      <span>Durability</span><span>{{system.durability.value}} / {{system.durability.max}}{{#if p.fixedDur}} <small>(doesn't scale)</small>{{/if}} <small>(spent <input type="number" name="system.wear" value="{{system.wear}}" {{#unless editable}}disabled{{/unless}}>)</small></span>
      <span>Limit</span><span>{{p.limit}}{{#if limitNote}} <small>({{limitNote}})</small>{{/if}}</span>
      <span>Recovery</span><span>{{recoveryLabel}}</span>
    </div>
    <p class="hint">Attuning takes an hour (not in combat); only one Shroud at a time. While attuned it soaks Physical, Elemental, and Magical damage before armor, and recovers at the start of your turn.</p>
  </section>

  {{#if p.effect}}
  <section class="fs-material"><h3>Effect</h3><p>{{p.effect}}</p></section>
  {{/if}}

  <section class="fs-affixes">
    <h3>Affixes <small>{{p.affixes.length}} attached · Free Affixes: {{p.freeAffixes}}</small></h3>
    <p class="hint">Everyone attunes one Affix at no cost; each Foci or Shroud adds its Free Affixes to that, and every attuned Affix past them lowers your speed by 20%.</p>
    {{#each slots}}
    <div class="fs-field"><label>Slot {{n}}</label>
      <select data-affix-slot="{{n}}" {{#unless ../editable}}disabled{{/unless}}>
        <option value="">— None —</option>
        {{#each ../affixChoices}}<optgroup label="{{label}}">{{selectOptions options selected=../value}}</optgroup>{{/each}}
      </select></div>
    {{#if info}}<p class="fs-affix-text"><strong>{{info.label}}:</strong> {{info.shroud}}</p>{{/if}}
    {{/each}}
    {{#if p.doubles}}{{#if p.affixes.length}}
    <div class="fs-field"><label>Doubled Affix <small>(while attuned, one Defensive Affix has its effects doubled)</small></label>
      <select name="system.doubled" {{#unless stateEditable}}disabled{{/unless}}>{{selectOptions doubledChoices selected=p.doubled}}</select></div>
    {{/if}}{{/if}}
    {{#if hasTourmaline}}
    <div class="fs-field"><label>Tourmaline element</label><select name="system.element" {{#unless stateEditable}}disabled{{/unless}}>{{selectOptions elements selected=system.element}}</select></div>
    {{/if}}
    {{#if hasColored}}
    <div class="fs-field"><label>Colored Diamond source (declare each turn)</label><select name="system.declared" {{#unless stateEditable}}disabled{{/unless}}>
      <option value="">— None —</option>{{selectOptions sources selected=system.declared}}</select></div>
    {{/if}}
    {{#if hasEmerald}}
    <div class="fs-field fs-checks-row"><label><input type="checkbox" name="system.lush" {{checked system.lush}} {{#unless stateEditable}}disabled{{/unless}}> In a Lush biome (Emerald)</label></div>
    {{/if}}
  </section>
  {{else}}
  <div class="fs-warn">{{p.error}}</div>
  {{/if}}

  <section>
    <h3>Notes</h3>
    <textarea name="system.description" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
  </section>
</div>
