<section class="tab fs-tab {{tab.cssClass}}" data-tab="skills" data-group="primary">
  <div class="fs-skill-points">
    {{#if skillView.gmPoints}}<label data-tooltip="GM: total Skill Points (spent + unspent)"><strong>Skill Points</strong> <input type="number" name="system.skillPoints" value="{{system.skillPoints}}" min="0" step="1"></label>
    {{else}}<span><strong>Skill Points</strong> {{skillView.points.total}}</span>{{/if}}
    <span><strong>Spent</strong> {{skillView.points.spent}}</span>
    <span class="{{#if skillView.points.unspent}}fs-has-points{{/if}}"><strong>Unspent</strong> {{skillView.points.unspent}}</span>
  </div>

  <div class="fs-skill-layout">
    <nav class="fs-skill-nav">
      <input type="search" class="fs-skill-filter" value="{{skillView.nav.filter}}" placeholder="Find a tree…" autocomplete="off">
      {{#each skillView.nav.groups}}
      <details class="fs-collapse fs-skill-group" data-section="{{key}}" {{#if open}}open{{/if}}>
        <summary><i class="fa-solid fa-chevron-down fs-caret"></i> <i class="{{icon}}"></i> {{label}} <span class="fs-skill-count">{{rows.length}}</span></summary>
        <ul>{{#each rows}}{{> fsSkillNavRow}}{{/each}}</ul>
      </details>
      {{/each}}
      {{#if skillView.nav.empty}}<p class="hint">No tree matches.</p>{{/if}}
    </nav>
    <div class="fs-skill-main">
      {{#with skillView.tree}}
      <header class="fs-skill-treehead">
        <h3>{{name}} <span class="fs-sub">{{archLabel}} · Tier {{current}}/{{max}}</span></h3>
        <a class="fs-codex-link fs-codex-icon" data-codex="{{codex}}" data-tooltip="Open this tree in the Codex"><i class="fa-solid fa-book-open"></i></a>
        {{#if @root.skillView.nav.canPin}}<button type="button" class="fs-inline fs-skill-pin {{#if pinned}}on{{/if}}" data-action="pinTree" data-tree="{{id}}" data-tooltip="{{#if pinned}}Unpin it from the top of the list{{else}}Pin it to the top of the list{{/if}}"><i class="fa-solid fa-thumbtack"></i></button>{{/if}}
      </header>
      {{/with}}
      {{#if skillView.lockedNote}}<p class="hint"><i class="fa-solid fa-lock"></i> {{skillView.lockedNote}}</p>{{/if}}
      {{#if skillView.scaleNote}}<p class="hint"><i class="fa-solid fa-scale-balanced"></i> {{skillView.scaleNote}}</p>{{/if}}
      {{#if skillView.weaponNote}}<p class="hint fs-weapon-note"><i class="fa-solid fa-khanda"></i> {{skillView.weaponNote}}</p>{{/if}}
    {{#with skillView.tree}}
    <div class="fs-tree">
      {{#each tiers}}
      <section class="fs-tier {{#if owned}}fs-tier-owned{{/if}} {{#if isNext}}fs-tier-next{{/if}} {{#if locked}}fs-tier-locked{{/if}}">
        <header class="fs-tier-head">
          <span class="fs-tier-num">Tier {{tier}}</span>
          <span class="fs-tier-summary">{{summary}}</span>
          <span class="fs-tier-state">
            {{#if automated}}<span class="fs-tier-badge fs-auto" data-tooltip="{{automated}}"><i class="fa-solid fa-wand-magic-sparkles"></i> {{automatedLabel}}</span>{{/if}}
            {{#if free}}<span class="fs-tier-badge">Free</span>
            {{else if owned}}<span class="fs-tier-badge"><i class="fa-solid fa-check"></i> Unlocked</span>
              {{#if canLower}}<button type="button" class="fs-inline" data-action="lowerTier" data-tree="{{../id}}" data-tooltip="GM: remove this tier (refunds {{cost}} SP)"><i class="fa-solid fa-rotate-left"></i></button>{{/if}}
            {{else if isNext}}<button type="button" class="fs-unlock" data-action="unlockTier" data-tree="{{../id}}" data-tooltip="{{reason}}" {{#unless canUnlock}}disabled{{/unless}}><i class="fa-solid fa-lock-open"></i> Unlock · {{cost}} SP</button>
            {{else}}<span class="fs-tier-badge fs-muted" data-tooltip="{{reason}}"><i class="fa-solid fa-lock"></i> {{cost}} SP</span>{{/if}}
          </span>
        </header>
        <ul class="fs-tier-entries">
          {{#each entries}}
          <li>{{#if name}}<strong><a class="fs-codex-name" data-codex="{{codex}}" data-tooltip="Open in the Codex">{{name}}</a>:</strong> {{/if}}{{#if energy}}<span class="fs-energy" data-tooltip="{{energy.tip}}"><i class="fa-solid fa-bolt"></i> {{energy.formula}}{{#if energy.value}} <span class="fs-energy-value">{{energy.value}}</span>{{/if}}</span> {{/if}}{{text}}
            {{#if sub}}<ul>{{#each sub}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
          </li>
          {{/each}}
        </ul>
      </section>
      {{/each}}
    </div>
    {{/with}}
    {{#with skillView.table}}
    <section class="fs-tier fs-wonder-table">
      <header class="fs-tier-head"><span class="fs-tier-num"><i class="fa-solid fa-dice-d20"></i> {{title}}</span><span class="fs-tier-summary">d100</span></header>
      <p class="hint">{{note}}</p>
      <table class="fs-table">
        <thead><tr><th>Roll</th><th>Effect</th></tr></thead>
        <tbody>{{#each rows}}<tr><td class="fs-table-roll">{{roll}}</td><td>{{effect}}</td></tr>{{/each}}</tbody>
      </table>
    </section>
    {{/with}}

    </div>
  </div>
</section>
