<section class="tab fs-tab {{tab.cssClass}}" data-tab="reactions" data-group="primary">
  <p class="hint">Everything that can prompt this character: popups asked mid-fight (usually in someone else's turn) and offer cards the system posts. Click one to switch it off or back on. Off, a popup counts as "no" and an offer card isn't posted; nothing is spent either way.</p>
  {{#each reactionGroups}}
  <details class="fs-collapse fs-action-group" data-section="{{key}}" {{#if open}}open{{/if}}>
    <summary class="fs-block-title"><i class="fa-solid fa-chevron-down fs-caret"></i> {{name}}</summary>
    <ul class="fs-action-list">
      {{#each actions}}
      <li class="fs-action {{#if off}}fs-dim{{/if}}">
        <button type="button" class="fs-action-btn" data-action="{{action}}" data-op="{{op}}"><i class="{{icon}}"></i></button>
        <span class="fs-action-name">{{label}}</span>
        <span class="fs-action-detail">{{detail}}</span>
        <span class="fs-action-cost">{{cost}}</span>
      </li>
      {{/each}}
    </ul>
  </details>
  {{else}}
  <p class="hint">Nothing can prompt this character yet: switches show up here as they gain Wonders, Tenets, Wards and tree tiers that ask or offer something.</p>
  {{/each}}
</section>
