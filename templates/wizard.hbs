{{#*inline "fsTreeTiers"}}
<ul class="fs-wizard-tree-tiers">
  {{#each tiers}}<li class="{{#if owned}}fs-owned{{/if}}"><strong>T{{tier}}</strong> <span class="fs-tier-summary">{{summary}}</span>
    <ul class="fs-wizard-entries">{{#each entries}}<li data-tooltip="{{full}}">{{#if name}}<strong>{{#if codex}}<a class="fs-codex-name" data-codex="{{codex}}" data-tooltip="Open in the Codex">{{name}}</a>{{else}}{{name}}{{/if}}:</strong> {{/if}}{{text}}{{#if cost}} <span class="fs-entry-cost"><i class="fa-solid fa-bolt"></i> {{cost}}</span>{{/if}}{{#if sub.length}}<ul class="fs-wizard-sub">{{#each sub}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</li>{{/each}}</ul></li>{{/each}}
</ul>
{{#if table}}<details class="fs-wizard-table"><summary>{{table.title}} (d100)</summary>
  <table class="fs-table"><tbody>{{#each table.rows}}<tr><td class="fs-table-roll">{{roll}}</td><td>{{effect}}</td></tr>{{/each}}</tbody></table></details>{{/if}}
{{/inline}}
{{#*inline "fsTreeChip"}}<button type="button" class="fs-tree-chip {{#if open}}fs-open{{/if}}" data-action="treeToggle" data-key="{{key}}" data-tooltip="{{#if open}}Hide{{else}}Show{{/if}} this tree's tiers"><i class="fa-solid fa-chevron-{{#if open}}down{{else}}right{{/if}}"></i> {{label}}</button>{{/inline}}
{{#*inline "fsChoiceRow"}}<div class="fs-bg-row {{#if pickable}}fs-bg-pickable{{/if}}"><span class="fs-bg-label">{{#if pickable}}{{#if picked}}<i class="fa-solid fa-circle-check fs-done"></i>{{else}}<i class="fa-solid fa-circle-exclamation fs-todo"></i>{{/if}} {{/if}}{{label}}</span>
  <div class="fs-tree-chips">{{#each chips}}{{#if ../pickable}}<span class="fs-pick-opt {{#if picked}}fs-on{{/if}}"><button type="button" class="fs-pick-radio" data-action="pickChoice" data-slot="{{slot}}" data-id="{{id}}" data-tooltip="{{#if picked}}Unpick{{else}}Pick{{/if}} {{label}}"><i class="fa-{{#if picked}}solid fa-circle-check{{else}}regular fa-circle{{/if}}"></i></button>{{> fsTreeChip}}</span>{{else}}{{> fsTreeChip}}{{/if}}{{/each}}</div></div>{{/inline}}
{{#*inline "fsOpenTree"}}{{#if openTree}}<div class="fs-chip-tree">
  <div class="fs-chip-tree-head"><strong>{{openTree.name}}</strong>{{#if openTree.tier}} <span class="fs-tier-badge">Tier {{openTree.tier}} from this</span>{{/if}} <a class="fs-codex-link fs-codex-icon" data-codex="tree:{{openTree.id}}" data-tooltip="Open this tree in the Codex"><i class="fa-solid fa-book-open"></i></a></div>
  {{#with openTree}}{{> fsTreeTiers}}{{/with}}
</div>{{/if}}{{/inline}}
<div class="fs-wizard-wrap {{#if tutorial}}fs-tutorial-mode{{/if}}">
  <nav class="fs-wizard-steps">
    {{#each steps}}
    <a class="fs-wizard-step {{#if active}}active{{/if}} {{#if done}}done{{/if}}" data-action="goto" data-step="{{index}}"{{#if ../tutorial}} data-tooltip="{{#if done}}Locked in{{else}}Coming up{{/if}}"{{/if}}>
      <span class="fs-step-num">{{#if done}}<i class="fa-solid fa-check"></i>{{else}}{{num}}{{/if}}</span> {{label}}
    </a>
    {{/each}}
  </nav>

  <div class="fs-wizard-body">
    {{#if tutorial}}<div class="fs-tut-banner"><i class="fa-solid fa-graduation-cap"></i> <span>{{tutorial.banner}}</span>
      <button type="button" class="fs-tut-again" data-action="tutorialAgain" data-tooltip="Show this step's explanation again"><i class="fa-solid fa-circle-question"></i></button></div>{{/if}}
    {{#if is_ancestry}}
    <h2>Ancestry</h2>
    <p class="hint">The people you are born to. It sets your Size and opens your Ancestry's skill trees (its core tree's Tier 0 is free). Then you pick a Background from its list.{{#if anc}} Click your pick again to see the whole list.{{/if}}</p>
    <div class="fs-abc-list">
      {{#each ancestries}}{{#unless hidden}}
      <div class="fs-abc-card {{#if selected}}fs-picked{{/if}}">
        <header><button type="button" class="fs-abc-pick" data-action="pickAncestry" data-id="{{id}}" data-tooltip="{{#if selected}}Unpick it (shows every Ancestry again){{else}}Pick {{name}}{{/if}}">{{#if selected}}<i class="fa-solid fa-circle-check"></i>{{else}}<i class="fa-regular fa-circle"></i>{{/if}} {{name}}</button>
          {{#if selected}}<button type="button" class="fs-abc-change" data-action="pickAncestry" data-id="{{id}}"><i class="fa-solid fa-rotate-left"></i> Change</button>{{/if}}
          <span class="fs-sub">Size {{size}} · {{lifespan}}</span></header>
        <div class="fs-sub">{{#each profile}}<p><strong>{{name}}:</strong> {{text}}</p>{{/each}}</div>
        <div class="fs-sub"><strong>Languages:</strong> {{languages}}</div>
        <div class="fs-tree-chips"><strong>Trees:</strong> {{#each chips}}{{> fsTreeChip}}{{/each}}</div>
        {{> fsOpenTree}}
      </div>
      {{/unless}}{{/each}}
    </div>
    {{#if glandChoices}}
    <div class="fs-field"><label>Elemental Gland</label><select name="abc.element"><option value="">— Pick an element —</option>{{#each glandChoices}}<option value="{{k}}" {{#if selected}}selected{{/if}}>{{v}}</option>{{/each}}</select></div>
    {{/if}}
    {{/if}}

    {{#if is_background}}
    <h2>Background</h2>
    {{#unless anc}}<p class="hint">Pick an Ancestry first.</p>{{else}}
    <p class="hint">How you were raised and what you did before the story began. It gives <strong>15 free points</strong> of starting skill trees: they unlock the trees and count toward requirements, but not toward your Skill Points (dice, the Stat Bonus, Energy).</p>
    <div class="fs-abc-list">
      {{#each backgrounds}}{{#unless hidden}}
      <div class="fs-abc-card {{#if selected}}fs-picked{{/if}}">
        <header><button type="button" class="fs-abc-pick" data-action="pickBackground" data-id="{{id}}" data-tooltip="{{#if selected}}Unpick it (shows every Background again){{else}}Pick {{name}}{{/if}}">{{#if selected}}<i class="fa-solid fa-circle-check"></i>{{else}}<i class="fa-regular fa-circle"></i>{{/if}} {{name}}</button>
          {{#if selected}}<button type="button" class="fs-abc-change" data-action="pickBackground" data-id="{{id}}"><i class="fa-solid fa-rotate-left"></i> Change</button>{{/if}}</header>
        <div class="fs-bg-trees">
          {{#if fixed.length}}<div class="fs-bg-row"><span class="fs-bg-label">Trees</span><div class="fs-tree-chips">{{#each fixed}}{{> fsTreeChip}}{{/each}}</div></div>{{/if}}
          {{#each rows}}{{> fsChoiceRow}}{{/each}}
          {{#if focuses.length}}<div class="fs-bg-row"><span class="fs-bg-label">{{#if selected}}{{#if focusPicked}}<i class="fa-solid fa-circle-check fs-done"></i>{{else}}<i class="fa-solid fa-circle-exclamation fs-todo"></i>{{/if}} {{/if}}Pick a focus</span></div>{{/if}}
          {{#each focuses}}<div class="fs-bg-focus {{#if picked}}fs-on{{/if}}">
            <div class="fs-bg-row"><span class="fs-bg-label">{{#if pickable}}<button type="button" class="fs-pick-radio" data-action="pickFocus" data-focus="{{name}}" data-tooltip="{{#if picked}}Unpick{{else}}Pick{{/if}} {{name}}"><i class="fa-{{#if picked}}solid fa-circle-check{{else}}regular fa-circle{{/if}}"></i></button> {{/if}}<strong>{{name}}</strong></span>
              <div class="fs-tree-chips">{{#each fixed}}{{> fsTreeChip}}{{/each}}</div></div>
            {{#each rows}}{{> fsChoiceRow}}{{/each}}
          </div>{{/each}}
        </div>
        {{> fsOpenTree}}
        {{#if selected}}{{#if ../owed}}
        <div class="fs-bg-alloc">
          <p class="fs-budget"><strong>{{../allocCost}}</strong> of {{../owed}} points spent on your Ancestry's trees. <span class="hint">Tier N costs N; requirements apply.</span></p>
          <ul class="fs-wizard-trees">
            {{#each ../allocRows}}
            <li class="fs-wizard-tree {{#if tier}}fs-picked{{/if}}"><div class="fs-wizard-tree-head">
              <a class="fs-wizard-tree-name" data-action="treeToggle" data-key="{{key}}"><i class="fa-solid fa-chevron-{{#if open}}down{{else}}right{{/if}}"></i> {{name}}</a> <a class="fs-codex-link fs-codex-icon" data-codex="tree:{{id}}" data-tooltip="Open this tree in the Codex"><i class="fa-solid fa-book-open"></i></a>
              <span class="fs-tier-badge">Tier {{tier}}/5</span>{{#if need}} <span class="hint">{{need}}</span>{{/if}}
              <button type="button" class="fs-inline" data-action="allocDown" data-tree="{{id}}" {{#unless canLower}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
              <button type="button" class="fs-inline" data-action="allocUp" data-tree="{{id}}" {{#unless canRaise}}disabled{{/unless}}><i class="fa-solid fa-plus"></i>{{#if nextCost}} {{nextCost}}{{/if}}</button>
            </div>{{#if open}}{{> fsTreeTiers}}{{/if}}</li>
            {{/each}}
          </ul>
        </div>
        {{/if}}{{/if}}
      </div>
      {{/unless}}{{/each}}
    </div>
    {{/unless}}
    {{/if}}

    {{#if is_culture}}
    <h2>Culture</h2>
    {{#unless pkg}}<p class="hint">Pick an Ancestry and a Background first.</p>{{else}}
    <p class="hint">Purely roleplay: your Homeland is the people and place you come from, your Circle the group you came up in through your Background. They set your values, customs and ties, with no game effect.</p>
    <h3>Homeland</h3>
    <div class="fs-abc-list">
      {{#each homelands}}{{#unless hidden}}
      <label class="fs-abc-card fs-abc-radio {{#if selected}}fs-picked{{/if}}"><input type="radio" name="abc.homeland" value="{{id}}" {{#if selected}}checked{{/if}}>
        <strong>{{name}}</strong>{{#if shared}} <span class="fs-sub">(Shared)</span>{{/if}}{{#if selected}} <button type="button" class="fs-abc-change" data-action="clearCulture" data-part="homeland"><i class="fa-solid fa-rotate-left"></i> Change</button>{{/if}}<span class="fs-sub">{{text}}</span></label>
      {{/unless}}{{/each}}
    </div>
    <h3>Circle</h3>
    <div class="fs-abc-list">
      {{#each circles}}{{#unless hidden}}
      <label class="fs-abc-card fs-abc-radio {{#if selected}}fs-picked{{/if}}"><input type="radio" name="abc.circle" value="{{id}}" {{#if selected}}checked{{/if}}>
        <strong>{{name}}</strong>{{#if shared}} <span class="fs-sub">(Shared)</span>{{/if}}{{#if selected}} <button type="button" class="fs-abc-change" data-action="clearCulture" data-part="circle"><i class="fa-solid fa-rotate-left"></i> Change</button>{{/if}}<span class="fs-sub">{{text}}</span></label>
      {{/unless}}{{/each}}
    </div>
    {{/unless}}
    {{/if}}

    {{#if is_stats}}
    <h2>Stats</h2>
    <p class="fs-budget {{#if overspent}}fs-over{{/if}}">
      <strong>{{remaining}}</strong> of {{rules.statPoints}} stat points left.
      {{#if remaining}}{{#unless overspent}}<span class="hint">Unspent points stay banked for later.</span>{{/unless}}{{/if}}
    </p>
    <div class="fs-stats">
      {{#each statGroups}}
      <div class="fs-stat-group">
        <h3>{{name}}</h3>
        {{#each stats}}
        <div class="fs-wizard-stat">
          <label>{{label}}</label>
          <input type="number" name="stats.{{key}}" value="{{value}}" min="0" step="1">
          <span class="fs-sub" data-tooltip="With the Stat Bonus from {{@root.preview.skillPoints}} Skill Points">{{effective}} · d{{die}}</span>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    <div class="fs-facts fs-wizard-preview">
      <span><strong>HP</strong> {{preview.hp}}</span>
      <span><strong>Pain Threshold</strong> {{preview.pain}}</span>
      <span><strong>Energy</strong> {{preview.energy}}</span>
      <span><strong>Move</strong> {{preview.move}} ft</span>
      <span><strong>Attack</strong> d{{preview.attackDie}}</span>
      <span><strong>Dodge</strong> 2d{{preview.dodgeDie}}</span>
      <span><strong>Skill Points</strong> {{preview.skillPoints}}</span>
    </div>
    {{/if}}

    {{#if is_skills}}
    <h2>Skill Trees</h2>
    <p class="fs-budget"><strong>{{remainingSP}}</strong> of {{skillPoints}} Skill Points left.
      <span class="hint">Tier N costs N; your Background's free tiers cost nothing. Unspent points stay banked for later.</span></p>
    <div class="fs-skill-pickers">
      <label>Archetype or Group
        <select name="skillArch">{{#each archetypes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}{{#if placeholder}} (coming soon){{/if}}</option>{{/each}}</select>
      </label>
    </div>
    {{#if archPlaceholder}}<p class="hint">{{archPlaceholder}}</p>{{else}}
    <ul class="fs-wizard-trees">
      {{#each treeRows}}
      <li class="fs-wizard-tree {{#if tier}}fs-picked{{/if}}">
        <div class="fs-wizard-tree-head">
          <a class="fs-wizard-tree-name" data-action="treeToggle" data-tree="{{id}}"><i class="fa-solid fa-chevron-{{#if open}}down{{else}}right{{/if}}"></i> {{name}}</a> <a class="fs-codex-link fs-codex-icon" data-codex="tree:{{id}}" data-tooltip="Open this tree in the Codex"><i class="fa-solid fa-book-open"></i></a>
          <span class="fs-tier-badge">Tier {{tier}}/5{{#if freeTier}} · {{freeTier}} free{{/if}}</span>
          <button type="button" class="fs-inline" data-action="treeDown" data-tree="{{id}}" data-tooltip="{{lowerTip}}" {{#unless canLower}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
          <button type="button" class="fs-inline" data-action="treeUp" data-tree="{{id}}" data-tooltip="{{#if nextCost}}Tier {{nextCost}} costs {{nextCost}} SP{{else}}Maxed{{/if}}" {{#unless canRaise}}disabled{{/unless}}><i class="fa-solid fa-plus"></i>{{#if nextCost}} {{nextCost}}{{/if}}</button>
        </div>
        {{#if open}}
        {{> fsTreeTiers}}
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{#if lockedTrees}}<p class="hint">{{lockedTrees}} more tree(s) open up as you raise {{theoryName}}.</p>{{/if}}
    {{/if}}
    <p class="hint">Full ability text is on your sheet's Skills tab. You can keep spending banked points there later.</p>
    {{/if}}

    {{#if is_equipment}}
    <h2>Starting Equipment</h2>
    <p class="fs-budget">Pick up to <strong>{{rules.items}}</strong> items (<strong>{{slotsLeft}}</strong> left), {{rarityLabel}} or lower, Grade {{rules.grade}}. At most one armor. Each Affix is one pick (a gem attuned to its Offensive or Defensive form; each costs 20% speed past your Free Affixes). Unarmed comes free; each ranged weapon comes with 20 ammunition.</p>
    {{#each items}}
    <div class="fs-wizard-item">
      <header class="fs-wizard-item-head">
        <strong class="fs-wizard-item-name">{{name}}</strong>
        {{#if rarity}}<span class="fs-rarity fs-rarity-{{rarity.key}}">{{rarity.label}}</span>{{/if}}
        <span class="fs-wizard-item-links">{{#each links}}<a class="fs-codex-link" data-codex="{{codex}}" data-tooltip="Open {{label}} in the Codex"><i class="fa-solid fa-book-open"></i> {{label}}</a>{{/each}}</span>
        <button type="button" class="fs-wizard-remove" data-action="removeItem" data-index="{{index}}" data-tooltip="Remove this item"><i class="fa-solid fa-xmark"></i></button>
      </header>
      <div class="fs-builder">
        {{#if namedSlot}}
        <div class="fs-field"><label>Named item</label><select name="items.{{index}}.key">{{selectOptions namedChoices selected=key}}</select></div>
        {{else if magic}}
        <div class="fs-field"><label>{{#if foci}}Foci{{else}}Shroud{{/if}} type</label><select name="items.{{index}}.{{#if foci}}fociType{{else}}shroudType{{/if}}">
          {{#each typeChoices}}<optgroup label="{{label}}">{{selectOptions options selected=../selected}}</optgroup>{{/each}}</select></div>
        {{else if icon}}
        <div class="fs-field"><label>Icon Form</label><select name="items.{{index}}.iconForm">
          {{#each typeChoices}}<optgroup label="{{label}}">{{selectOptions options selected=../selected}}</optgroup>{{/each}}</select></div>
        {{else if affixSlot}}
        <div class="fs-field"><label>Affix</label><select name="items.{{index}}.affix">{{selectOptions affixChoices selected=affix}}</select></div>
        <div class="fs-field"><label>Attuned to its</label><select name="items.{{index}}.side">{{selectOptions sideChoices selected=side}}</select></div>
        {{else}}
        {{#unless armor}}
        <div class="fs-field"><label>Type</label><select name="items.{{index}}.type">{{selectOptions @root.weaponTypes selected=type}}</select></div>
        {{/unless}}
        <div class="fs-field"><label>Weight</label><select name="items.{{index}}.weight">{{selectOptions weights selected=weight}}</select></div>
        <div class="fs-field"><label>Material</label><select name="items.{{index}}.material">{{selectOptions materials selected=material}}</select></div>
        {{#if extraChoices.length}}
        <div class="fs-field"><label>Extra types <small>(Weapon Master)</small></label>
          <div class="fs-checks-row">{{#each extraChoices}}<label><input type="checkbox" name="items.{{../index}}.extra.{{key}}" {{checked on}}> {{label}}</label>{{/each}}</div></div>
        {{/if}}
        {{/if}}
      </div>
      {{#if facts.length}}<dl class="fs-wizard-facts">{{#each facts}}<div{{#if tip}} data-tooltip="{{tip}}"{{/if}}><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>
      {{else}}<div class="fs-sub">{{summary}}</div>{{/if}}
      {{#if tags.length}}<div class="fs-tags">{{#each tags}}<span class="fs-tag" data-tooltip="{{tooltip}}" data-codex="tag:{{key}}">{{label}}</span>{{/each}}</div>{{/if}}
      {{#each notes}}<p class="fs-wizard-note {{#if on}}fs-on{{/if}}"><strong>{{label}}:</strong> {{text}}</p>{{/each}}
      {{#if effect}}<div class="fs-sub fs-wizard-effect">{{effect}}</div>{{/if}}
    </div>
    {{else}}
    <p class="hint">No items picked yet.</p>
    {{/each}}
    <div class="fs-wizard-add">
      <span class="fs-wizard-add-label">Add{{#unless slotsLeft}} <span class="hint">(no picks left)</span>{{/unless}}</span>
      <div class="fs-wizard-add-buttons">
        <button type="button" class="{{#if suggest.weapon}}fs-suggested{{/if}}" data-action="addItem" data-kind="weapon" data-tooltip="Martial: a weapon (type, weight, material)" {{#unless canAddWeapon}}disabled{{/unless}}><i class="fa-solid fa-khanda"></i> {{#if suggest.weapon}}★ {{/if}}Weapon</button>
        <button type="button" class="{{#if suggest.armor}}fs-suggested{{/if}}" data-action="addItem" data-kind="armor" data-tooltip="Martial: armor (at most one)" {{#unless canAddArmor}}disabled{{/unless}}><i class="fa-solid fa-shirt"></i> {{#if suggest.armor}}★ {{/if}}Armor</button>
        <button type="button" class="{{#if suggest.foci}}fs-suggested{{/if}}" data-action="addItem" data-kind="foci" data-tooltip="Magic: the item you cast spells through" {{#unless canAddMagic}}disabled{{/unless}}><i class="fa-solid fa-wand-sparkles"></i> {{#if suggest.foci}}★ {{/if}}Foci</button>
        <button type="button" class="{{#if suggest.shroud}}fs-suggested{{/if}}" data-action="addItem" data-kind="shroud" data-tooltip="Magic: a protective layer that soaks damage before armor" {{#unless canAddMagic}}disabled{{/unless}}><i class="fa-solid fa-ghost"></i> {{#if suggest.shroud}}★ {{/if}}Shroud</button>
        <button type="button" class="{{#if suggest.icon}}fs-suggested{{/if}}" data-action="addItem" data-kind="icon" data-tooltip="Mental: a Form with a Ward effect" {{#unless canAddMagic}}disabled{{/unless}}><i class="fa-solid fa-hands-praying"></i> {{#if suggest.icon}}★ {{/if}}Icon</button>
        <button type="button" class="{{#if suggest.affix}}fs-suggested{{/if}}" data-action="addItem" data-kind="affix" data-tooltip="Magic: a gem attuned on its own, to its Offensive or Defensive form" {{#unless canAddAffix}}disabled{{/unless}}><i class="fa-solid fa-gem"></i> {{#if suggest.affix}}★ {{/if}}Affix</button>
        {{#if canAddNamed}}<button type="button" data-action="addItem" data-kind="named" data-tooltip="One of the GM's named items from the catalog"><i class="fa-solid fa-star"></i> Named item</button>{{/if}}
      </div>
    </div>
    {{/if}}

    {{#if is_notes}}
    <h2>Notes</h2>
    <div class="fs-wizard-identity">
      <img class="fs-portrait" src="{{img}}" alt="" data-action="pickImage" data-tooltip="Click to change the portrait">
      <div class="fs-field-stack">
        <label>Name <input type="text" name="name" value="{{name}}" placeholder="Character name"></label>
        <label>Portrait
          <span class="fs-inline-row">
            <input type="text" name="img" value="{{img}}">
            <button type="button" class="fs-inline" data-action="pickImage" data-tooltip="Change the portrait"><i class="fa-solid fa-image"></i></button>
          </span>
        </label>
        <p class="fs-sub">{{anc.name}}{{#if backgroundName}} · {{backgroundName}}{{/if}}{{#if homelandName}} · {{homelandName}}{{/if}}{{#if circleName}} · {{circleName}}{{/if}}</p>
      </div>
    </div>
    <p class="hint">Anything else about your character, if you want: it goes on your sheet's Notes tab.</p>
    <div class="fs-wizard-details">
      {{#each details}}
      <label class="{{#if long}}fs-detail-long{{/if}}">{{label}}
        {{#if long}}<textarea name="details.{{k}}" rows="3">{{value}}</textarea>{{else}}<input type="text" name="details.{{k}}" value="{{value}}">{{/if}}
      </label>
      {{/each}}
    </div>
    <h3>Summary</h3>
    <div class="fs-facts">
      <span><strong>HP</strong> {{preview.hp}}</span><span><strong>Energy</strong> {{preview.energy}}</span>
      <span><strong>Skill Points</strong> {{preview.skillPoints}}</span><span><strong>Banked stat points</strong> {{remaining}}</span>
    </div>
    <div class="fs-facts">{{#each statGroups}}{{#each stats}}<span><strong>{{label}}</strong> {{value}}</span>{{/each}}{{/each}}</div>
    <div class="fs-facts">{{#each pickedTrees}}<span>{{this}}</span>{{else}}<span>No trees yet ({{remainingSP}} SP banked)</span>{{/each}}</div>
    <ul class="fs-list">{{#each items}}<li>{{name}} — {{summary}}</li>{{else}}<li>Unarmed only</li>{{/each}}</ul>
    {{#if purse}}<p><strong>Starting purse:</strong> {{purse}}</p>{{/if}}
    {{#if errors.length}}
    <div class="fs-wizard-errors"><strong>Fix these first:</strong><ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul></div>
    {{else}}
    <p class="hint">Once created, your sheet is locked. Stats, Skill Points, and equipment change only through the GM (you can spend granted stat points yourself).</p>
    {{/if}}
    {{/if}}
  </div>

  <footer class="fs-wizard-footer">
    <button type="button" data-action="back" {{#if backDisabled}}disabled{{/if}}{{#if tutorial}} data-tooltip="The tutorial only goes forward"{{/if}}><i class="fa-solid fa-arrow-left"></i> Back</button>
    {{#if isLast}}
    <button type="button" class="fs-primary" data-action="finish" {{#unless ready}}disabled{{/unless}}><i class="fa-solid fa-check"></i> {{#if editing}}Apply{{else}}Create character{{/if}}</button>
    {{else}}
    <button type="button" class="fs-primary" data-action="next">Next <i class="fa-solid fa-arrow-right"></i></button>
    {{/if}}
  </footer>
</div>
