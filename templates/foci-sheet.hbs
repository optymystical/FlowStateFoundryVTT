<div class="fs-sheet">
  <header class="fs-header">
    <img class="fs-portrait fs-small" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
    <div class="fs-header-main">
      <input class="fs-name" type="text" name="name" value="{{item.name}}" {{#unless nameEditable}}disabled{{/unless}}>
      {{#if p.valid}}<div class="fs-subtitle">Foci · {{p.label}}</div>{{/if}}
    </div>
  </header>

  {{#if lockedNote}}<p class="fs-locked"><i class="fa-solid fa-lock"></i> {{lockedNote}}</p>{{/if}}
  {{> fsItemCatalog}}
  <section class="fs-builder">
    <div class="fs-field"><label>Type</label>
      <select name="system.fociType" {{#unless editable}}disabled{{/unless}}>
        {{#each typeGroups}}<optgroup label="{{label}}">{{selectOptions options selected=../system.fociType}}</optgroup>{{/each}}
      </select></div>
    {{#if system.natural}}<div class="fs-field"><label>Grade</label><a class="fs-sub" data-codex="equipment:natural" data-tooltip="A natural item has no Grade: it scales with the stat uncapped">Natural: no Grade</a></div>{{else}}
    <div class="fs-field"><label>Grade</label>
      <input type="number" name="system.grade" value="{{system.grade}}" min="1" {{#unless editable}}disabled{{/unless}}></div>
    {{/if}}
    <div class="fs-field fs-checks-row">
      <label><input type="checkbox" name="system.attuned" {{checked system.attuned}} {{#unless stateEditable}}disabled{{/unless}}> Attuned</label>
      <label data-tooltip="Part of a creature: no Grade (Reach/Grasp count uncapped); it can't be dropped or sold"><input type="checkbox" name="system.natural" {{checked system.natural}} {{#unless editable}}disabled{{/unless}}> Natural</label>
      <label><input type="checkbox" name="system.equipped" {{checked system.equipped}} {{#unless stateEditable}}disabled{{/unless}}> Held</label>
      <label><input type="checkbox" name="system.twoHanded" {{checked system.twoHanded}} {{#unless stateEditable}}disabled{{/unless}}> Two hands</label>
    </div>
  </section>

  {{#if p.valid}}
  <section class="fs-profile">
    <h3>Profile {{#unless owned}}<small>(previewed at the Grade cap)</small>{{/unless}}</h3>
    <div class="fs-kv">
      <span>Casting form</span><span>{{p.formLabel}} — {{p.formText}}</span>
      <span>Scaling</span><span>{{scalingLabel}} {{p.scaling}} {{#if p.natural}}(natural: uncapped){{else}}(Grade {{p.grade}} caps it at {{cap}}){{/if}}</span>
      <span>Cast AP</span><span>{{p.castAP}}</span>
      <span>Threshold Reduction</span><span>{{#if trLabel}}{{trLabel}}{{else}}—{{/if}}</span>
      <span>Durability</span><span>{{system.durability.value}} / {{system.durability.max}} <small>(wear <input type="number" name="system.wear" value="{{system.wear}}" min="0" {{#unless editable}}disabled{{/unless}}>)</small></span>
      <span>Limit</span><span>{{p.limit}}</span>
      <span>Hands</span><span>{{#if p.twoHandCast}}Two hands to cast{{else}}One hand (a held item){{/if}}</span>
    </div>
    <p class="hint">Attuning takes an hour (not in combat); only one Foci can be attuned at a time. Affixes and passives only work while attuned, for spells cast through it.</p>
  </section>

  {{#if p.effect}}
  <section class="fs-material"><h3>Effect</h3><p>{{p.effect}}</p></section>
  {{/if}}
  {{#if isRing}}
  <div class="fs-field"><label>Chosen Core spell (Ring)</label><select name="system.chosenSpell" {{#unless stateEditable}}disabled{{/unless}}>{{selectOptions spellChoices selected=system.chosenSpell}}</select></div>
  {{/if}}

  <section class="fs-affixes">
    <h3>Affixes <small>{{p.affixes.length}} working here · Free Offensive Affixes: {{p.freeAffixes}}</small></h3>
    <p class="hint">Affixes are attuned on their own (Equipment tab, Offensive form) and work through your Foci and raw casting. Every attuned Affix lowers your speed by 20%, not counting the Free Affixes of your attuned Foci (Offensive) and Shroud (Defensive).</p>
    {{#each attached}}
    <p class="fs-affix-text"><strong>{{label}}{{#if doubled}} (doubled){{/if}}:</strong> {{text}}</p>
    {{else}}<p class="hint">No Offensive Affixes are attuned.</p>
    {{/each}}
    {{#if p.doubles}}{{#if p.affixes.length}}
    <div class="fs-field"><label>Doubled Affix <small>(while attuned, one Offensive Affix has its effects doubled)</small></label>
      <select name="system.doubled" {{#unless stateEditable}}disabled{{/unless}}>{{selectOptions doubledChoices selected=p.doubled}}</select></div>
    {{/if}}{{/if}}
    {{#if hasOpal}}
    <div class="fs-field"><label>Black Opal: range that gets +50%</label><select name="system.opalRange" {{#unless stateEditable}}disabled{{/unless}}>{{selectOptions opalChoices selected=system.opalRange}}</select></div>
    {{/if}}
    {{#if hasEmerald}}
    <div class="fs-field fs-checks-row"><label><input type="checkbox" name="system.lush" {{checked system.lush}} {{#unless stateEditable}}disabled{{/unless}}> In a Lush biome (Emerald)</label></div>
    {{/if}}
  </section>
  {{else}}
  <div class="fs-warn">{{p.error}}</div>
  {{/if}}

  <section>
    <h3>Notes</h3>
    <textarea name="system.description" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
  </section>
</div>
