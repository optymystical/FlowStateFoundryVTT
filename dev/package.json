{
  "name": "flowstate-dev",
  "private": true,
  "type": "module",
  "description": "Test harnesses and tools for the Flow State Foundry VTT system (not loaded by Foundry).",
  "scripts": {
    "test": "node run-tests.mjs",
    "trees": "python3 tools/build_trees.py docs/martial.md docs/magic.md docs/mental.md ../module/trees.mjs",
    "combos": "python3 tools/build_combos.py docs/combos.md ../module/combos.mjs",
    "bold": "python3 tools/build_bold.py",
    "lint": "cd .. && eslint --max-warnings 0 module dev/run-tests.mjs dev/tests",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "handlebars": "^4.7.8"
  }
}
